# ============================================
# OmniAI — Production Environment Configuration
# ============================================
# Copy this to .env and fill in values.
# NEVER commit the real .env to version control.
# Generate secure secrets with: openssl rand -hex 32

# --------------------------------------------------
# REQUIRED CORE — the app will not start without these
# --------------------------------------------------

# Production mode
NODE_ENV=production

# Port the server binds to (hosting platform usually provides this)
PORT=3000

# Bind host (use 0.0.0.0 on container platforms)
HOST=0.0.0.0

# Application public URL (no trailing slash) — used for CORS, callbacks, links
APP_URL=https://your-domain.com

# CORS — comma-separated list of allowed origins (your frontend domain)
# Single-process: same origin, can be the APP_URL
CORS_ORIGIN=https://your-domain.com

# --- Database (Supabase) ---
# From Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key — SERVER-SIDE ONLY. NEVER expose to frontend.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Authentication ---
# Generate: openssl rand -hex 64
# Must be at least 32 characters. Use a long random string.
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-64-HEX-CHARS
# Access token lifetime (seconds) — 7 days default
JWT_ACCESS_EXPIRES=604800
# Refresh token lifetime (seconds) — 30 days default
JWT_REFRESH_EXPIRES=2592000

# --- AI Provider (at least one required for AI features) ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic (alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ============================================
# OPTIONAL SERVICES — app still runs without these
# ============================================

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_yyy

# --- Email (choose one provider) ---
SENDGRID_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="OmniAI <noreply@your-domain.example>"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# --- File storage ---
# Local directory for document uploads (ensure write access)
UPLOAD_DIR=server/uploads
# Max upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# --- AI Kill Switch ---
# Set to "true" to globally disable AI generation (emergency)
AI_KILL_SWITCH=false

# --- Beta mode ---
# Enable beta-only features (feedback, analytics, search)
OMNIAI_BETA=true

# --- Rate limiting ---
# Requests per window
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000