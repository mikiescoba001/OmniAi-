# ============================================
# OmniAI — .gitignore
# Protects secrets and build artifacts
# ============================================

# Environment files — NEVER commit these
.env
.env.*
!.env.example
.env.production
.env.local

# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Uploaded files (user data — never commit)
server/uploads/
uploads/

# Editor/IDE
.vscode/
.idea/
*.swp

# Test artifacts
coverage/
.nyc_output/